PORT=5002
NODE_ENV=development

# Supabase Project URL and server-side secret key. The secret key stays in this backend only.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace_with_server_side_secret
SUPABASE_STORAGE_BUCKET=plant-images

# Create a key at https://openrouter.ai/keys. This free vision model accepts image input;
# provider rate limits and data-handling terms apply.
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_SITE_URL=http://localhost:5173

# Use a random secret of at least 32 characters.
JWT_SECRET=replace_with_at_least_32_random_characters

# Comma-separated origins allowed to call this API.
CLIENT_URL=http://localhost:5173
